ActiveThorns = "ioutil nanchecker"
ActiveThorns = "CarpetLib Carpet CarpetReduce CarpetRegrid2 CarpetIOScalar CartGrid3D CoordBase InitBase SymBase"
 
cactus::cctk_itlast = 0
driver::ghost_size = 1

# CartGrid3D
CartGrid3D::type = "coordbase"
CartGrid3D::avoid_origin = "no"
CoordBase::domainsize = "minmax"
CoordBase::spacing    = "gridspacing"
CoordBase::xmin =   0
CoordBase::xmax =  10
CoordBase::ymin =   0
CoordBase::ymax =  10
CoordBase::zmin =   0
CoordBase::zmax =  10
CoordBase::dx   =   1
CoordBase::dy   =   1
CoordBase::dz   =   1

CoordBase::boundary_size_x_lower     = 1
CoordBase::boundary_size_x_upper     = 1
CoordBase::boundary_size_y_lower     = 1
CoordBase::boundary_size_y_upper     = 1
CoordBase::boundary_size_z_lower     = 1
CoordBase::boundary_size_z_upper     = 1

Carpet::prolongation_order_space = 0
Carpet::prolongation_order_time = 0

Carpet::max_refinement_levels = 3
CarpetRegrid2::regrid_every =   0
CarpetRegrid2::num_centres  =   1
CarpetRegrid2::num_levels_1 =   3

CarpetRegrid2::radius_1[1]  =   2.5
CarpetRegrid2::radius_1[2]  =   1.25
CarpetRegrid2::position_x_1 =  5
CarpetRegrid2::position_y_1 =  5
CarpetRegrid2::position_z_1 =  5

# Carpet
Carpet::domain_from_coordbase = "yes"
Carpet::init_fill_timelevels = "yes"

# the output dir will be named after the parameter file name
IO::out_fileinfo  = "none"
IO::parfile_write = "no"
IO::out_dir = $parfile

NaNChecker::check_vars = "NANCHECKER::TestMaskGFs"
NaNChecker::check_every = 1
NaNChecker::setup_test = "yes"

IOScalar::outScalar_vars = "NaNChecker::NaNMask"
IOScalar::outScalar_reductions = "minimum maximum"
IOScalar::outScalar_every = 1
